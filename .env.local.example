# Copie pra .env.local e preencha. Nunca commite .env.local (já está no .gitignore).

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://edaogdfeuxrylwqpopqe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API Keys → service_role (SECRETA — nunca no client, nunca commitada)
