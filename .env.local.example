# Copie pra .env.local e preencha. Nunca commite .env.local (já está no .gitignore).

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://edaogdfeuxrylwqpopqe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API Keys → service_role (SECRETA — nunca no client, nunca commitada)
SUPABASE_SERVICE_ROLE_KEY=

# Mesmo OAuth client do Google usado no login (Supabase Auth → Providers → Google) —
# tem que ser o MESMO client_id/secret das edge functions do secretaria-agentic.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Trello (developer.trello.com/docs/get-started) → chave da aplicação (não é
# por tenant — cada usuário ainda usa o próprio token pessoal no wizard).
# Sem isso, o passo 2 do onboarding cai pro modo manual (cola o JSON direto).
TRELLO_API_KEY=

# Número do WhatsApp compartilhado da plataforma, em E.164 com formatação pra
# exibição (ex: "+55 11 91234-5678") — só usado pra mostrar na tela do wizard
# ("manda o código pra esse número"). Não afeta o roteamento em si (isso é
# controlado nas edge functions por PLATFORM_EVOLUTION_INSTANCE); sem isso, o
# wizard mostra as instruções sem o número, só com o código.
NEXT_PUBLIC_WHATSAPP_NUMBER=
